<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07090d">
  <meta name="description" content="NOVEX TEC — Smart Tech. Better Deals. Tech, Gadgets und digitale Dienstleistungen.">
  <title>NOVEX TEC | Smart Tech. Better Deals.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=DM+Mono&display=swap" rel="stylesheet">

  <style>
    :root {
      --black: #07090d;
      --panel: #0e131c;
      --panel2: #111a27;
      --blue: #087bff;
      --cyan: #12c8f4;
      --silver: #e4e9f1;
      --muted: #929cab;
      --line: #29313f;
      --font: "Manrope", Arial, sans-serif;
      --mono: "DM Mono", monospace;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      margin: 0;
      background: var(--black);
      color: var(--silver);
      font-family: var(--font);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 4px;
    }
    .wrap { width: min(1160px, calc(100% - 40px)); margin: auto; }
    .mono {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .blue { color: var(--cyan); }
    .muted { color: var(--muted); }
    .dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      margin-right: 8px;
      background: var(--cyan);
      border-radius: 50%;
      box-shadow: 0 0 12px #12c8f4;
    }

    .topbar {
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
      background: #050609;
      color: #aab4c4;
    }
    .topbar .wrap {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(7,9,13,.93);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid #222b39;
    }
    nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: .07em;
      text-decoration: none;
      white-space: nowrap;
    }
    .brand-symbol {
      width: 35px;
      height: 35px;
      display: grid;
      place-items: center;
      background: linear-gradient(140deg, #f7f9fd, #a8b4c6);
      color: #080a0e;
      font-size: 13px;
      font-weight: 800;
      clip-path: polygon(0 0,100% 62%,100% 100%,0 40%);
    }
    .brand small {
      display: block;
      margin-top: 3px;
      color: var(--cyan);
      font: 10px var(--mono);
      letter-spacing: .45em;
    }
    .navlinks { display: flex; align-items: center; gap: 22px; }
    .navlinks a {
      color: #c3cbd7;
      text-decoration: none;
      font-size: 12px;
      font-weight: 700;
      transition: color .2s;
    }
    .navlinks a:hover, .footerlinks a:hover { color: var(--cyan); }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 47px;
      padding: 0 19px;
      background: var(--blue);
      color: white;
      border: 1px solid var(--blue);
      text-decoration: none;
      font-size: 12px;
      font-weight: 800;
      transition: .2s;
      cursor: pointer;
    }
    .btn:hover {
      background: #0067dc;
      border-color: #0067dc;
      transform: translateY(-2px);
    }
    .btn.secondary {
      background: transparent;
      color: var(--silver);
      border-color: #465164;
    }
    .btn.secondary:hover { color: var(--cyan); border-color: var(--cyan); }
    .menu {
      display: none;
      background: transparent;
      color: var(--silver);
      border: 1px solid var(--line);
      padding: 8px 12px;
      font-size: 21px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 95px 0 85px;
    }
    .hero:before {
      content: "";
      position: absolute;
      top: -180px;
      right: -130px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, #0758ba25, transparent 68%);
      pointer-events: none;
    }
    .hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 55px;
      align-items: center;
    }
    .eyebrow { color: var(--cyan); margin-bottom: 25px; }
    h1 {
      margin: 0;
      font-size: clamp(52px, 7.3vw, 94px);
      line-height: .98;
      letter-spacing: -.075em;
      font-weight: 800;
    }
    .hero-copy {
      max-width: 550px;
      margin: 27px 0;
      color: #aab4c4;
      font-size: 15px;
      line-height: 1.9;
    }
    .actions { display: flex; gap: 11px; flex-wrap: wrap; }
    .micro { margin-top: 22px; color: #7f8999; }

    .hero-art {
      min-height: 415px;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      padding: 24px;
      border: 1px solid #29384e;
      background: linear-gradient(145deg, #101722, #07090d 70%);
    }
    .hero-art:before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image:
        linear-gradient(#8ca7c20b 1px, transparent 1px),
        linear-gradient(90deg, #8ca7c20b 1px, transparent 1px);
      background-size: 27px 27px;
    }
    .art-top { display: flex; justify-content: space-between; color: #a5b1c1; }
    .orbit {
      position: absolute;
      top: 80px;
      left: 50%;
      width: 235px;
      height: 235px;
      transform: translateX(-50%);
      border: 1px solid #4c6b91;
      border-radius: 50%;
      box-shadow: 0 0 55px #087bff15;
    }
    .orbit:before, .orbit:after {
      content: "";
      position: absolute;
      inset: 24px;
      border: 1px solid #37516f;
      border-radius: 50%;
    }
    .orbit:after { inset: 52px; border-color: #087bff80; }
    .core {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 132px;
      height: 132px;
      display: grid;
      place-items: center;
      transform: translate(-50%,-35%) rotate(-7deg);
      background: linear-gradient(145deg, #f8fafc, #aab6c7);
      color: #080a0e;
      font-size: 43px;
      font-weight: 800;
      letter-spacing: -.1em;
      clip-path: polygon(0 0,100% 60%,100% 100%,0 40%);
    }
    .core:after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: 35%;
      height: 100%;
      background: linear-gradient(180deg, #16d2ff, #0066ff);
      clip-path: polygon(100% 0,100% 100%,0 60%,0 30%);
    }
    .art-bottom {
      position: absolute;
      right: 24px;
      bottom: 24px;
      left: 24px;
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 15px;
    }
    .art-bottom strong { display: block; font-size: 18px; }
    .art-bottom span { color: #a6b0c0; font-size: 10px; line-height: 1.8; }

    .ticker { background: #090c12; border-block: 1px solid var(--line); }
    .ticker .wrap {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
      padding: 21px 0;
      color: #a2adbd;
    }
    .ticker b { color: var(--cyan); margin-right: 8px; }

    section.section { padding: 90px 0; }
    .section-head {
      display: grid;
      grid-template-columns: .55fr 1.45fr;
      gap: 35px;
      margin-bottom: 40px;
    }
    .index { color: var(--cyan); padding-top: 7px; }
    h2 {
      margin: 0;
      font-size: clamp(36px, 5vw, 61px);
      line-height: 1.04;
      letter-spacing: -.07em;
    }
    .intro {
      max-width: 680px;
      margin: 19px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.9;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .card {
      min-height: 235px;
      display: flex;
      flex-direction: column;
      padding: 25px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      transition: background .2s;
    }
    .card:hover { background: var(--panel); }
    .card-top { display: flex; justify-content: space-between; color: #8995a7; }
    .card-icon {
      width: 39px;
      height: 39px;
      display: grid;
      place-items: center;
      color: var(--cyan);
      background: #0b1523;
      border: 1px solid #34465f;
      font-size: 17px;
    }
    .card h3 { margin: 25px 0 9px; font-size: 19px; letter-spacing: -.04em; }
    .card p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.85; }
    .card a {
      margin-top: auto;
      padding-top: 20px;
      color: var(--cyan);
      font-size: 12px;
      font-weight: 800;
      text-decoration: none;
    }

    .dark-section {
      background: #0b0f16;
      border-block: 1px solid #1c2533;
    }
    .deal-panel {
      margin-top: 25px;
      padding: 23px;
      border: 1px solid #24466f;
      background: linear-gradient(120deg, #0b1a2e, #0b1018);
    }
    .deal-panel strong { display: block; margin: 9px 0; }
    .deal-panel p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }

    .two-col {
      display: grid;
      grid-template-columns: 1fr .85fr;
      gap: 60px;
    }
    .principles { margin-top: 28px; border-top: 1px solid var(--line); }
    .principle {
      display: grid;
      grid-template-columns: 38px 1fr;
      gap: 14px;
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
    }
    .principle .num { color: var(--cyan); }
    .principle h3 { margin: 0 0 6px; font-size: 15px; }
    .principle p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
    .manifesto {
      min-height: 320px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      padding: 35px;
      border: 1px solid #29384c;
      background: linear-gradient(145deg, #101722, #080a0e);
    }
    .manifesto blockquote {
      position: relative;
      z-index: 1;
      margin: 35px 0;
      font-size: clamp(30px, 3.7vw, 45px);
      line-height: 1.12;
      letter-spacing: -.07em;
    }
    .manifesto:after {
      content: "N/";
      position: absolute;
      right: -5px;
      bottom: -60px;
      color: #ffffff05;
      font-size: 210px;
      font-weight: 800;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      border-top: 1px solid var(--line);
    }
    .step { padding: 24px 24px 0 0; }
    .step h3 { margin: 17px 0 8px; font-size: 17px; }
    .step p { color: var(--muted); font-size: 12px; line-height: 1.85; }

    .contact {
      padding: 85px 0;
      background: linear-gradient(120deg, #071a31, #07090d 75%);
      border-block: 1px solid #1d3b5e;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr .8fr;
      gap: 55px;
      align-items: end;
    }
    .contact-copy { color: #aab5c6; line-height: 1.9; font-size: 14px; }
    .contact-box { padding: 25px; border: 1px solid #29415f; background: #0a1019; }
    .email {
      display: block;
      margin: 16px 0;
      color: var(--silver);
      font-size: clamp(17px,2vw,23px);
      font-weight: 800;
      overflow-wrap: anywhere;
      text-decoration: none;
    }
    .email:hover { color: var(--cyan); }
    .contact-box p { color: var(--muted); font-size: 12px; line-height: 1.8; }

    footer { padding: 30px 0; background: #050609; }
    .footer-inner { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .footerlinks { display: flex; gap: 18px; flex-wrap: wrap; }
    .footerlinks a { color: #a7b1c0; font-size: 11px; text-decoration: none; }
    .copyright {
      width: 100%;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      padding-top: 18px;
      border-top: 1px solid #242a35;
      color: #798495;
    }

    @media(max-width:900px) {
      .hero-grid, .contact-grid, .two-col { grid-template-columns: 1fr; }
      .hero-grid { gap: 40px; }
      .section-head { grid-template-columns: 1fr; gap: 12px; }
      .cards { grid-template-columns: repeat(2,1fr); }
      .navlinks { gap: 12px; }
      .navlinks a { font-size: 11px; }
    }
    @media(max-width:650px) {
      .wrap { width: calc(100% - 32px); }
      nav { min-height: 68px; }
      .menu { display: block; }
      .navlinks {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        padding: 12px 20px 20px;
        background: #080b11;
        border-bottom: 1px solid var(--line);
      }
      .navlinks.open { display: flex; flex-direction: column; align-items: stretch; }
      .navlinks a { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
      nav > .btn { display: none; }
      .hero { padding: 65px 0; }
      h1 { font-size: clamp(49px,14vw,75px); }
      .hero-art { min-height: 335px; }
      .orbit { width: 200px; height: 200px; top: 72px; }
      .core { width: 115px; height: 115px; }
      .ticker .wrap { justify-content: flex-start; }
      .ticker span { width: calc(50% - 10px); font-size: 9px; }
      section.section { padding: 70px 0; }
      .cards, .steps { grid-template-columns: 1fr; }
      .card { min-height: 210px; }
      .step { padding: 20px 0; border-bottom: 1px solid var(--line); }
      .manifesto { min-height: 275px; padding: 28px; }
      .actions .btn { width: 100%; }
      .copyright { font-size: 9px; }
    }
    @media(prefers-reduced-motion:reduce) {
      *,*::before,*::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</head>

